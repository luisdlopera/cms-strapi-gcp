{
  "kind": "collectionType",
  "collectionName": "articulos",
  "info": {
    "singularName": "articulo",
    "pluralName": "articulos",
    "displayName": "Artículo",
    "description": "Contenido editorial para el CMS del curso"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true,
      "minLength": 3,
      "maxLength": 160
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true
    },
    "resumen": {
      "type": "text",
      "required": true,
      "maxLength": 320
    },
    "contenido": {
      "type": "blocks",
      "required": true
    },
    "categoria": {
      "type": "enumeration",
      "enum": ["noticias", "tutoriales", "institucional"],
      "default": "noticias",
      "required": true
    }
  }
}
